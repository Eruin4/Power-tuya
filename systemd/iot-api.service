[Unit]
Description=Local authenticated Tuya IoT API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/project/power-tuya
ExecStart=%h/project/power-tuya/.venv/bin/python %h/project/power-tuya/iot_api.py
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
